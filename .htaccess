# ----------------------------------------------------------------------
# Support Management System (.htaccess)
# ----------------------------------------------------------------------

# Disable Directory Browsing
Options -Indexes

# Set Default Charset
AddDefaultCharset UTF-8

# Protect Sensitive Configuration, Lock & Database Files
<FilesMatch "(?i)\.(sql|lock|env|ini|log|sh|bak|config)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Block access to hidden files/directories (like .git)
<FilesMatch "^\.">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Apache 2.4+ Direct Protection for Sensitive Files
<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(sql|lock|env|ini|log|sh|bak|config)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Set Default Document
DirectoryIndex index.php
